<Window x:Class="AuctionSystem.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="320" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" FontWeight="Bold"
                   Text="Вход в систему" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Логин:" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="LoginBox" Grid.Row="1" Grid.Column="1" Margin="6,4"
                 KeyDown="Field_KeyDown"/>

        <TextBlock Grid.Row="2" Text="Пароль:" VerticalAlignment="Center" Margin="0,4"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="6,4"
                     KeyDown="Field_KeyDown"/>

        <CheckBox x:Name="RememberBox" Grid.Row="3" Grid.Column="1" Margin="6,8"
                  Content="Запомнить меня"/>

        <TextBlock x:Name="MessageText" Grid.Row="4" Grid.ColumnSpan="2"
                   TextWrapping="Wrap" Margin="0,8" Foreground="#C00000"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Войти" Width="90" Margin="0,0,8,0" IsDefault="True"
                    Click="LoginButton_Click"/>
            <Button Content="Отмена" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
