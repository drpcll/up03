<Window x:Class="AuctionSystem.Views.AuctionCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка аукциона" Height="900" Width="1240"
        MinHeight="780" MinWidth="1050"
        WindowStartupLocation="CenterOwner" Background="#F2F6FC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE5F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7A8CA3"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2A37"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F4E79"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1F4E79"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Обложка аукциона -->
        <Border Grid.Row="0" Background="#1F4E79" ClipToBounds="True">
            <Grid Height="242">
                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                <Border Background="#D91A3550"/>
                <Grid Margin="34,22,34,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Border x:Name="StatusBadge" DockPanel.Dock="Right"
                                Background="#E8F5E9" CornerRadius="14" Padding="14,6"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                         Fill="#2E7D32" Margin="0,0,7,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Статус"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="КАРТОЧКА АУКЦИОНА"
                                   Foreground="#BFD3E6" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Foreground="White"
                                   FontSize="36" FontWeight="Bold"
                                   TextWrapping="Wrap" MaxHeight="96"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="DateText" Foreground="#F2F6FC"
                                       FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="   •   " Foreground="#9FBCD8" FontSize="15"/>
                            <TextBlock x:Name="PlaceText" Foreground="#D8E6F3"
                                       FontSize="15" TextTrimming="CharacterEllipsis"
                                       MaxWidth="620"/>
                        </StackPanel>
                    </StackPanel>

                    <DockPanel Grid.Row="2">
                        <TextBlock x:Name="OrganizerText" Foreground="#BFD3E6"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AuctionIdText" DockPanel.Dock="Right"
                                   Foreground="#9FBCD8" FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20,28,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Background="#E8F1FB" BorderBrush="#C9DDF2"
                            BorderThickness="1" CornerRadius="10" Padding="14,12"
                            Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="i" FontFamily="Georgia" FontSize="18"
                                       FontWeight="Bold" Foreground="#1F4E79"
                                       Margin="2,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="RoleNoteText" Foreground="#24425F"
                                       FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Информация об аукционе" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Дата и время" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="DateTimeText" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Место проведения" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="PlaceInfoText" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Специфика" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="SpecifikaText" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Организатор" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="OrganizerInfoText" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Идентификатор" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="IdInfoText" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Итоги торгов" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="3" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LotsCountText" Text="0"
                                               FontSize="21" FontWeight="Bold" Foreground="#1F4E79"/>
                                    <TextBlock Text="лотов" FontSize="10" Foreground="#7A8CA3"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="SoldCountText" Text="0"
                                               FontSize="21" FontWeight="Bold" Foreground="#2E7D32"/>
                                    <TextBlock Text="продано" FontSize="10" Foreground="#7A8CA3"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="TotalText" Text="0 ₽"
                                               FontSize="16" FontWeight="Bold" Foreground="#1F4E79"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="сумма продаж" FontSize="10" Foreground="#7A8CA3"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="CompositionText" Margin="0,10,0,0"
                                       FontSize="10" Foreground="#7A8CA3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="LotsHeaderText" DockPanel.Dock="Right"
                                   Foreground="#7A8CA3" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <TextBlock Text="Лоты аукциона" FontSize="19" FontWeight="Bold"
                                   Foreground="#1F4E79" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyLotsText" Text="В этом аукционе пока нет лотов."
                                   Foreground="#7A8CA3" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="LotsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="382" Height="176" Margin="0,0,16,16"
                                            Background="White" BorderBrush="#DCE5F0"
                                            BorderThickness="1" CornerRadius="10"
                                            ToolTip="{Binding Details}"
                                            ToolTipService.ShowDuration="20000">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="146"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Margin="10" Background="#F5F8FC"
                                                    CornerRadius="8" ClipToBounds="True">
                                                <Image Source="{Binding Photo}" Stretch="Uniform"
                                                       Margin="4" SnapsToDevicePixels="True"/>
                                            </Border>
                                            <Grid Grid.Column="1" Margin="2,9,12,9">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               DockPanel.Dock="Right"
                                                               Foreground="{Binding StatusBrush}"
                                                               FontSize="10" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding NumberText}"
                                                               Foreground="#7A8CA3"
                                                               FontSize="10" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Title}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1F2A37" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="38" Margin="0,5,0,0"/>
                                                <StackPanel Grid.Row="2" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding PriceText}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="#1F4E79"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SellerText}"
                                                               FontSize="10" Foreground="#7A8CA3"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Row="3" Background="{Binding BadgeBrush}"
                                                        CornerRadius="4" Padding="7,3"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,5,0,0"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding Badge}" Foreground="White"
                                                               FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE5F0"
                BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Обновить" Width="104" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
                    <Button Content="Закрыть" Width="92" IsCancel="True" Padding="12,6"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center"
                           FontSize="11" Foreground="#6B7C93" Visibility="Collapsed"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
