<UserControl x:Class="AuctionSystem.Views.SectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="ru-RU">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CardButton" Content="Карточка" Width="100" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="Card_Click"/>
                <Button x:Name="AddButton" Content="Добавить" Width="100" Margin="0,0,6,0"
                        Click="Add_Click"/>
                <Button x:Name="EditButton" Content="Изменить" Width="100" Margin="0,0,6,0"
                        Click="Edit_Click"/>
                <Button x:Name="DeleteButton" Content="Удалить" Width="90" Margin="0,0,16,0"
                        Click="Delete_Click"/>
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="SearchBox" Width="180" VerticalAlignment="Center"
                         Margin="0,0,6,0" KeyDown="Search_KeyDown"/>
                <Button Content="Найти" Width="70" Margin="0,0,6,0" Click="Search_Click"/>
                <Button Content="Сброс" Width="70" Click="Reset_Click"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="#555555" TextWrapping="Wrap"/>
        </Border>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F2F6FC" HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionChanged="Grid_SelectionChanged"
                  MouseDoubleClick="Grid_MouseDoubleClick"/>
    </DockPanel>
</UserControl>
