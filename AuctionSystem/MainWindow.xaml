<Window x:Class="AuctionSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аукционы" Height="760" Width="1280"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#F2F6FC" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,10" Background="#1F4E79">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SignInButton" Content="Вход" Width="86"
                            Style="{StaticResource HeaderButton}" Click="SignInButton_Click"/>
                    <Button x:Name="RegButton" Content="Регистрация" Width="110"
                            Style="{StaticResource HeaderButton}" Click="RegButton_Click"/>
                    <Button x:Name="SignOutButton" Content="Выход" Width="86"
                            Style="{StaticResource HeaderButton}" Click="SignOutButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="UserText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Margin="16,0,6,0" Foreground="#D8E6F3" FontSize="12" Text="Гость"/>
                <StackPanel>
                    <TextBlock Text="Аукционы" FontSize="21" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Информационная система аукционной фирмы"
                               FontSize="11" Foreground="#BFD3E6" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="MenuList" Grid.Column="0" Margin="0,0,10,0"
                     Background="White" BorderBrush="#DCE5F0" Padding="4" FontSize="13"
                     SelectionChanged="MenuList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <DockPanel Grid.Column="1">
                <TextBlock x:Name="SectionTitle" DockPanel.Dock="Top" FontSize="20"
                           FontWeight="Bold" Foreground="#1F4E79" Margin="0,0,0,10" Text="Обзор"/>
                <ContentControl x:Name="SectionHost"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Background="#E8EEF7" Padding="12,6" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="#4A5A6E" FontSize="11"/>
        </Border>
    </Grid>
</Window>
